{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rung decision",
  "description": "JSON object printed by `rung --format json check`. schema_version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "baseline_revision",
    "candidate_digest",
    "ledger_digest",
    "policy_digest",
    "governance_violations",
    "violations",
    "assessments"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "outcome": {
      "enum": ["allow", "allow_with_warnings", "require_review", "block"]
    },
    "baseline_revision": { "type": "string", "minLength": 1 },
    "candidate_digest": { "type": "string", "minLength": 1 },
    "ledger_digest": { "type": "string", "minLength": 1 },
    "policy_digest": { "type": "string", "minLength": 1 },
    "governance_violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "violations": { "type": "array" },
    "assessments": { "type": "array" }
  }
}
